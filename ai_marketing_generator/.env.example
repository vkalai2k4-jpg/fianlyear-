# Rename this file to .env and fill in your real values

# OpenRouter API key (get it from openrouter.ai/keys) - used for all AI
# content, banner text, campaign ideas and video script generation
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: change the model without touching code (default: anthropic/claude-sonnet-4.5)
# See openrouter.ai/models for other options
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Any random string for Flask sessions
SECRET_KEY=change_this_to_something_random

# Gmail SMTP (use an App Password, not your normal Gmail password)
GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
